{
  "manifest_version": 3,
  "name": "Odds Dropper",
  "version": "1.5.2",
  "description": "Monitors POD /terminal only. No access to Clerk, sign-in, or BetBCK.",
  "permissions": [
    "tabs",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://www.pinnacleoddsdropper.com/terminal",
    "https://www.pinnacleoddsdropper.com/terminal*",
    "https://swordfish-production.up.railway.app/*",
    "https://sword.pinnacleoddsdropper.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pinnacleoddsdropper.com/terminal",
        "https://www.pinnacleoddsdropper.com/terminal*"
      ],
      "exclude_matches": [
        "https://www.pinnacleoddsdropper.com/sign-in*",
        "https://www.pinnacleoddsdropper.com/sign-up*",
        "https://www.pinnacleoddsdropper.com/*/sign-in*",
        "https://clerk.pinnacleoddsdropper.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    },
    "default_title": "Odds Dropper"
  }
}
